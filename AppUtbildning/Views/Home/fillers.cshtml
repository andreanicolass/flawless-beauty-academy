<!-- All kod är från presentationer och https://www.w3schools.com/html/default.asp-->
@model AppUtbildning.Models.Register
@{
  ViewData["Title"] = "Fillerutbildning – Flawless Beauty Academy";
  ViewData["Course"] = "Fillers";
  ViewData["CourseName"] = "Fillers – Grundutbildning";
  Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
  <link rel="stylesheet" href="~/css/course.css" asp-append-version="true" />
}

<main class="course-page">
  <section class="hero" style="--hero-img: url('/images/fillers.PNG')">
    <div class="container">
      <div class="hero-content">
        <span class="eyebrow">Grundutbildning</span>
        <h1>Fillers</h1>
        <p>Bygg en trygg bas inom fillers med teori, anatomi och upp till 10 elevbehandlingar under handledning.</p>
        <div class="hero-actions">
          <a href="#intresse" class="btn btn-light">Anmäl intresse</a>
          <a href="#intro" class="btn btn-ghost-light">Läs mer</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Snabbfakta -->
  <div class="container">
    <div class="facts">
      <div class="card fact"><span>Pris</span><strong>29 000 kr</strong></div>
      <div class="card fact"><span>Upplägg</span><strong>eLearning + praktik</strong></div>
      <div class="card fact"><span>Praktik</span><strong>Upp till 10 behandlingar</strong></div>
      <div class="card fact"><span>Bevis</span><strong>Certifikat</strong></div>
    </div>
  </div>

  <!-- Introduktion -->
  <section class="section" id="intro">
    <div class="container split">
      <div>
        <span class="eyebrow">Om utbildningen</span>
        <h2>En grundlig start med hyaluronsyrafillers</h2>
      </div>
      <div>
        <p class="lead">
          Flawless Beauty Academys Dermal Filler – Grundutbildning är en grundlig start för dig som vill
          arbeta säkert och effektivt med hyaluronsyrafillers. Kursen kombinerar tydlig teori med praktisk träning på riktiga modeller,
          så att du kan gå från kunskap till trygg klinisk handling.
        </p>
        <ul class="checklist">
          <li>Teori + praktik (advanced 10 områden)</li>
          <li>Målgrupp: leg. läkare, tandläkare och sjuksköterskor</li>
          <li>Certifikat efter genomförd utbildning</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Kursupplägg -->
  <section class="section section-soft" id="kursupplagg">
    <div class="container">
      <span class="eyebrow">Kursupplägg</span>
      <h2>Två delar – teori och praktik</h2>
      <p class="muted">Utbildningen är uppdelad i två delar för att effektivt integrera kunskap och färdighetsträning.</p>
      <div class="parts">
        <div class="card part">
          <span class="num">01</span>
          <h3>eLearning</h3>
          <p>Interaktiv teori, webbinarium och bemannad chatt.</p>
        </div>
        <div class="card part">
          <span class="num">02</span>
          <h3>Praktik på plats</h3>
          <p>Live-demo på modell och handledd träning i små grupper.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Behörighet -->
  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Behörighet</span>
        <h2>Vem kan gå kursen?</h2>
      </div>
      <div class="notice">
        <p>Enligt lag krävs legitimation som läkare, tandläkare eller sjuksköterska för att utföra fillers.
          Kontrollera att du uppfyller kraven innan du gör din intresseanmälan.</p>
      </div>
    </div>
  </section>

  <partial name="_Intresseanmalan" model="Model" />
</main>
