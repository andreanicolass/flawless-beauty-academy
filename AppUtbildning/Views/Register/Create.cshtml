@model AppUtbildning.Models.Register

@{
    ViewData["Title"] = "Ny anmälan";
    Layout = "_Layout"; //Hjälp från en ramverk av en klasskompis men ändrade till mina egna variabler.
}

<main class="simple-page">
    <div class="card simple-card form-page">
        <span class="eyebrow">Anmälan</span>
        <h1>Ny anmälan</h1>
        <p class="muted">Fyll i uppgifterna och välj vilken utbildning anmälan gäller.</p>

        <form asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                <div class="field"><label asp-for="LastName"></label><input asp-for="LastName" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                <div class="field full"><label asp-for="Address"></label><input asp-for="Address" /><span asp-validation-for="Address" class="text-danger"></span></div>
                <div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="field"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
                <div class="field full">
                    <label asp-for="Course"></label>
                    <select asp-for="Course" asp-items="@(new SelectList(Register.Courses))">
                        <option value="">Välj utbildning</option>
                    </select>
                    <span asp-validation-for="Course" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Spara</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline">Tillbaka</a>
            </div>
        </form>
    </div>
</main>

@section Styles {
    <style>
        .form-page { max-width: 640px; text-align: left; }
        .form-page form { margin-top: 24px; }
        .form-actions { display: flex; gap: 10px; margin-top: 28px; }
    </style>
}
